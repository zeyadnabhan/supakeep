# Your domain (DNS A record must point to this server)
DOMAIN=supakeep.example.com

# Login password (at least 8 characters)
ADMIN_PASSWORD=change-me-to-a-long-password

# IANA timezone used for run times (e.g. Europe/Berlin)
TZ_NAME=UTC

# How often the scheduler checks for due projects (minutes)
CHECK_MINUTES=5

# Set to false only when testing locally over plain http
# COOKIE_SECURE=false
